# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public origin, used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://certitude.in

# ---------------------------------------------------------------------------
# Supabase (optional)
# ---------------------------------------------------------------------------
# Leave these blank and the site runs from the TypeScript seed catalogue with
# demo lead capture. Set them once the migration has been applied.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by /api/leads to write past RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Keep checkout OFF until you hold written supplier authorisation.
NEXT_PUBLIC_ENABLE_CHECKOUT=false
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_PRICE_HISTORY=false
NEXT_PUBLIC_ENABLE_WHATSAPP=true

# ---------------------------------------------------------------------------
# Payments (Phase 2 — not wired yet)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (Phase 2)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Certitude <orders@certitude.in>"
